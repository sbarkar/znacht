# Copy to deploy/.env. Never commit .env.
ZNACHT_API_TOKEN=change-me-to-a-long-random-string
ZNACHT_PUBLIC_URL=https://znacht.example.ch

# Adapters: memory is the built-in sample catalogue and store, good for trying Znacht out
ZNACHT_RECIPE_SOURCE=cookidoo
ZNACHT_SINK=cookidoo
ZNACHT_STORE=migros
ZNACHT_PLANNER=anthropic

# Cookidoo (password only needed for the first login; the token file is kept in /data)
ZNACHT_COOKIDOO_EMAIL=you@example.com
ZNACHT_COOKIDOO_PASSWORD=
ZNACHT_COOKIDOO_COUNTRY=ch
ZNACHT_COOKIDOO_LANGUAGE=en

# Migros: either copy migros-mcp's session.json to /data/migros-session.json, or set these for a first login
ZNACHT_MIGROS_EMAIL=
ZNACHT_MIGROS_PASSWORD=
ZNACHT_MIGROS_TOTP_SECRET=
ZNACHT_MIGROS_LANGUAGE=en

# Planner
ANTHROPIC_API_KEY=
ZNACHT_ANTHROPIC_MODEL=claude-opus-5-5
ZNACHT_ANTHROPIC_EFFORT=medium

# Home Assistant notifications (long-lived access token; notify service without the "notify." prefix)
ZNACHT_HA_URL=http://homeassistant.local:8123
ZNACHT_HA_TOKEN=
ZNACHT_HA_NOTIFY=mobile_app_your_phone
